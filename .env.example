# Kohu config template. Copy to .env and fill in (never commit .env):
#   cp .env.example .env
# .env is git-ignored; seed.sh checks META_API_KEY without printing it.

# Meta Model API key for Muse Spark parse + captions (judged path).
META_API_KEY=
# Full HTTPS chat-completions endpoint URL (deployment-specific, no default).
META_API_BASE=
# Parse/caption model, e.g. muse-spark.
META_PARSE_MODEL=
# Postgres connection (default suits local dev).
DATABASE_URL=postgresql://postgres@localhost:5432/kohu
